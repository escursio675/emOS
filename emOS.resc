mach create "emOS"
machine LoadPlatformDescription @/home/moitrayanchakravarty/micro/emOS/stm32f401re.repl
sysbus LoadELF @/home/moitrayanchakravarty/micro/emOS/firmware.elf
showAnalyzer sysbus.usart2

# Log every LD2 (PA5) change with a timestamp
logLevel -1 sysbus.gpioPortA.ld2

# Constant ADC readings (-1 = repeat forever). Run these again after any "machine Reset".
# Channel 0 = A0 (2048 -> about 1650 mV); channel 17 = internal reference (1501 -> VDDA about 3301 mV)
sysbus.adc1 FeedSample 2048 0 -1
sysbus.adc1 FeedSample 1501 17 -1

start
